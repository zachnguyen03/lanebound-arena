{
  "name": "lanebound-arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/match-contract",
    "packages/career",
    "apps/career"
  ],
  "description": "Lanebound Arena sandbox — deterministic headless sim",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/watch/tsconfig.json --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:watch-app": "vitest run --config apps/watch/vitest.config.ts",
    "digest": "tsx apps/lab/digest.ts",
    "purity": "tsx apps/lab/purity.ts",
    "lab:s0": "tsx apps/lab/lab-s0.ts",
    "lab:s1": "tsx apps/lab/lab-s1.ts",
    "mutation:s1": "tsx apps/lab/mutation-s1.ts",
    "gen:watch-sample": "tsx apps/lab/gen-watch-sample.ts",
    "watch:dev": "vite --config apps/watch/vite.config.ts",
    "watch:build": "vite build --config apps/watch/vite.config.ts",
    "watch:preview": "vite preview --config apps/watch/vite.config.ts --host 127.0.0.1 --port 4173",
    "watch:e2e": "playwright test --config apps/watch/playwright.config.ts",
    "lab:s4": "tsx apps/lab/lab-s4.ts",
    "batch": "tsx apps/lab/batch.ts",
    "isolation": "tsx apps/lab/isolation-cli.ts",
    "lab:s5": "tsx apps/lab/lab-s5.ts",
    "manager:test": "for t in apps/manager/test/*.test.mjs; do tsx $t || exit 1; done",
    "manager:dev": "vite --config apps/manager/vite.config.ts",
    "manager:build": "vite build --config apps/manager/vite.config.ts",
    "manager:e2e": "playwright test --config apps/manager/playwright.config.ts",
    "manager:refit": "node apps/manager/test/refit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.6",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  }
}
