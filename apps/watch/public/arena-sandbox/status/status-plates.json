{
 "name": "Lanebound arena status plates",
 "version": 1,
 "sheet": "status-plates-2x.png",
 "sheet_1x": "status-plates-1x.png",
 "scale": 2,
 "note": "Plate 16x18 @1x (32x36 @2x): 16x16 content, 1 px rim rgb(110,122,148), fill #121722, 14x14 glyph at (1,1), 2 px duration bar rows 16-17, x 1..15 accent, x 0 track (9,12,18). Runtime draws the bar's remaining fraction by clipping from the right and painting the rest with the track colour. Same key shape as the champion atlas 'sprites' (Huntress vfx): {rect, anchor}; anchor = bottom-centre of the plate (the bar), block centred on the unit's foot x, bar bottom 2 px above the initial tag (1x map space; at 2x this is 4 px). 'status-<kind>' = plate, 'status-<kind>-glyph' = bare 14x14 glyph (HUD chips). Asset id = the key.",
 "head_rule": {
  "one_plate_per_unit": "the strongest DISABLE (lowest priority number in group 'disable'); ties inside a band: longest remaining duration",
  "overflow": "every other active status (disables, mark, buffs) folds into one '+N' chip beside the plate; N > 9 shows +9",
  "no_disable": "if the unit has no disable, the head shows its strongest of: mark, then buffs by priority (spawn-shield first)",
  "ground_cc": "root wick loops and slow chevrons stay at the feet (spectator/spec.md), independent of the head plate",
