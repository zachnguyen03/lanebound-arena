{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@sim/*": ["sim/*"],
      "@data/*": ["data/*"],
      "@lab/*": ["apps/lab/lib/*"],
      "@lanebound/match-contract": ["packages/match-contract/src/index.ts"],
      "@lanebound/career": ["packages/career/src/index.ts"]
    }
  },
  "include": ["sim/**/*", "apps/**/*", "tests/**/*", "data/**/*", "packages/**/*", "vitest.config.ts"],
  "exclude": ["apps/watch", "apps/career/e2e", "apps/career/playwright.config.ts", "apps/career/vite.config.ts", "apps/career/dist"]
}
